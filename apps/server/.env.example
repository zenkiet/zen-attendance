# Server Configuration
PORT=8080
ENV=development

# Database (Postgres)
# For local development, use localhost
# For Docker, use service name: postgres
DATABASE_URL=postgres://zen_user:zen_password@localhost:5432/zen_attendance?sslmode=disable

# Redis
# For local: localhost:6379
# For Docker: redis:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security - PASETO v4 Symmetric Key (32 bytes hex = 64 characters)
# IMPORTANT: Generate a new key for production using: openssl rand -hex 32
# This is a sample key - DO NOT use in production!
PASETO_KEY=a1b2c3d4e5f67890123456789abcdef0a1b2c3d4e5f67890123456789abcdef0
